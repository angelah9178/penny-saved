# Copy to /etc/penny-saved/backend.env with mode 0600 and replace every REPLACE_WITH value.
# Never commit the populated file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://penny_saved:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/penny_saved
FRONTEND_ORIGIN=https://stopimpulsebuying.us
SESSION_COOKIE_NAME=penny_saved_session
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
METRICS_ENABLED=true
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
TRUSTED_HOSTS=["stopimpulsebuying.us","www.stopimpulsebuying.us"]
TRUSTED_PROXY_NETWORKS=["127.0.0.1/32","::1/128"]
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_SIGNUP_IP_LIMIT=10
AUTH_SIGNUP_ACCOUNT_LIMIT=3
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_RANDOM_RATE_LIMIT_KEY_32_BYTES_MINIMUM
