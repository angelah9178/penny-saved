# Example only. Validate against the installed Nginx version before installation.
server {
    listen 80;
    listen [::]:80;
    server_name stopimpulsebuying.us www.stopimpulsebuying.us;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://stopimpulsebuying.us$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stopimpulsebuying.us;

    ssl_certificate /etc/letsencrypt/live/stopimpulsebuying.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stopimpulsebuying.us/privkey.pem;

    root /srv/penny-saved/current/frontend/dist;
    index index.html;
    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Metrics are scraped directly over loopback and are never publicly proxied.
    location = /internal/metrics {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.stopimpulsebuying.us;

    ssl_certificate /etc/letsencrypt/live/stopimpulsebuying.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stopimpulsebuying.us/privkey.pem;
    return 301 https://stopimpulsebuying.us$request_uri;
}
